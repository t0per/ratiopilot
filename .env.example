# Copie ce fichier en .env et adapte les valeurs.

# Mot de passe de l'interface web (obligatoire)
RP_PASSWORD=change-moi

# Nom de domaine servi par Traefik
RP_DOMAIN=ratio.example.com

# Réglages Traefik existant
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Utilisateur propriétaire du dossier ./data
PUID=1000
PGID=1000
TZ=Europe/Paris

# Optionnel : proxy HTTP pour les annonces (ex : http://gluetun:8888)
RP_HTTP_PROXY=
